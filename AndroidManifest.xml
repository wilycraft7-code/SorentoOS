<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.simple.carlauncher"
    android:versionCode="6"
    android:versionName="6.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Inicio"
        android:icon="@drawable/ic_apps"
        android:theme="@style/LauncherTheme">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppsActivity"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|locale" />

        <activity
            android:name=".RadioActivity"
            android:label="Radio"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|locale" />

        <activity
            android:name=".BtActivity"
            android:label="Bluetooth"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|locale" />

        <activity
            android:name=".ScreenOffActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden|locale" />

        <activity
            android:name=".SetupActivity"
            android:label="Configura tu inicio"
            android:configChanges="orientation|screenSize|keyboardHidden|locale" />

        <activity
            android:name=".EqActivity"
            android:label="Ecualizador"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|locale" />

        <service android:name=".VolumeOverlay" />
        <service android:name=".GreeterService" />
        <service android:name=".Odometer" />

        <activity
            android:name=".OilActivity"
            android:label="Aceite"
            android:configChanges="orientation|screenSize|keyboardHidden|locale" />

        <receiver android:name=".GreeterService$BootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".MainActivity$BootStart"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".MediaListener"
            android:label="Inicio"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
